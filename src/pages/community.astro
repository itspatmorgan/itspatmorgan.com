---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { commendations } from "@/data/commendations";
import { communityPhotos, communityStory } from "@/data/community";

const communityPagePhotos = communityPhotos.map((photo, index) => ({
  ...photo,
  className: ["rotate-[-2deg]", "rotate-[2deg]", "rotate-[-1deg]", "rotate-[1deg]"][index],
}));
---

<PageLayout title="Community — Patrick Morgan" description="Showing up for creative people in Los Angeles through writing, events, and community." image="/images/share/community.jpg">
  <PageHeader data-community-hero>
    <Fragment slot="title">Community</Fragment>
    <Fragment slot="lead">Showing up for creative people in Los Angeles through writing, events, and community.</Fragment>
  </PageHeader>

  {/* Photos break out of the reading column to the same width as the About page's. */}
  <section class="mx-auto max-w-5xl px-6 pb-12">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-5">
      {communityPagePhotos.map((photo) => (
        <figure class:list={[
          "bg-white p-2 pb-7 shadow-xl shadow-black/15 transition-transform duration-300 hover:rotate-0 hover:scale-[1.02] dark:bg-[#20201e] dark:shadow-black/40",
          photo.className,
        ]}>
          <div class="aspect-square overflow-hidden bg-muted">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class:list={[
                "block h-full w-full object-cover",
                photo.position,
              ]}
            />
          </div>
        </figure>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16" data-community-story>
    <p class="text-xl font-semibold leading-snug tracking-tight">
      Showing up for people who make things.
    </p>
    <div class="mt-5 space-y-4 text-base leading-relaxed text-muted-foreground">
      {communityStory.paragraphs.slice(0, 2).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24" data-community-words>
    <div class="mb-10">
      <h2 class="mb-3 text-xl font-semibold leading-snug tracking-tight">Kind words from the community.</h2>
      <p class="text-base leading-relaxed text-muted-foreground">
        A few notes from readers, event guests, and people in the design community.
      </p>
    </div>

    <div class="columns-1 gap-4 sm:columns-2">
      {commendations.map((c) => (
        <blockquote class="mb-4 break-inside-avoid rounded-lg p-5 texture-bg" data-kind-words-item>
          <p class="mb-4 font-mono text-[13px] leading-relaxed text-foreground">{c.quote}</p>
          <footer class="flex items-center gap-3">
            <img
              src={c.image}
              alt={c.name}
              class="h-8 w-8 shrink-0 rounded-full object-cover"
            />
            <div>
              <p class="text-sm font-medium leading-tight">{c.name}</p>
              <p class="text-xs text-muted-foreground">{c.role}</p>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
  </section>
</PageLayout>
