---
import PageLayout from "@/layouts/PageLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectDemo from "@/components/ProjectDemo.astro";
import { liveDemoSlugs } from "@/data/project-demos";
import PixelWaveText from "@/components/PixelWaveText.astro";
import LabCard from "@/components/lab/LabCard.astro";
import StudioHomeModule from "@/components/design-studio/StudioHomeModule.astro";
import { UAMark } from "@/lab/editorial-art/UAMark";
import { siteConfig } from "@/data/site-config";
import { commendations } from "@/data/commendations";
import { communityPhotos, featuredCommunityCommendations } from "@/data/community";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const preferredLabOrder = ["pattern-engine", "pixel-wave", "pixel-mark"];
const labEntries = (await getCollection("lab", ({ data }) => !data.draft))
  .sort((a, b) => {
    const aIndex = preferredLabOrder.indexOf(a.data.slug);
    const bIndex = preferredLabOrder.indexOf(b.data.slug);
    if (aIndex !== -1 || bIndex !== -1) {
      return (aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex) - (bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex);
    }
    return a.data.title.localeCompare(b.data.title);
  });
// The homepage's writing list drops a title's closing aside, like "(And That's Okay)", so each title fits on one line.
const shortTitle = (title: string) => title.replace(/\s*\([^)]*\)$/, "");
const writingPosts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
const professionalProjects = allProjects
  .filter((p) => p.data.type === "professional")
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const featuredProjectDescriptions: Record<string, string> = {
  "sublime-agents": "Designed an AI agent that writes detection rules, and gives security teams control over its autonomy.",
  "query-language": "Designed a visual query builder that taught a complex query language as customers used it.",
  expansion: "Shaped how a new SKU came to market by extending the platform, not rebuilding it.",
  "design-studio": "Designed and built the environment where Sublime's product team and their agents prototype together, then open-sourced it.",
};

const heroHeadline = "Patrick is a designer who builds.";
const heroIntro = "I've been a strategist, developer, designer, and writer — sometimes all at once.";
const heroIntroDetail = "The through line is my compulsion to turn ideas into useful, well-crafted things.";
const heroCurrentWorkLead = "Right now, I'm designing agentic email security at";
const heroCurrentWorkTail = "an open-source prototyping environment.";

const communityCommendations = featuredCommunityCommendations
  .map((name) => commendations.find((commendation) => commendation.name === name))
  .filter((commendation) => Boolean(commendation));
// All four Community page photos in one row of prints, tilted alternately; the crops are the Community page's own.
const homeCommunityPhotos = communityPhotos.map((photo, i) => ({
  ...photo,
  className: ["rotate-[-2deg]", "rotate-[1.5deg]", "rotate-[-1deg]", "rotate-[2deg]"][i],
}));

// 1296 less 56 a side leaves 1184 of content, the case studies' widest stage, so the homepage and the work it links to share one measure.
const homeShell = "mx-auto w-full max-w-[1296px] px-6 sm:px-8 lg:px-14";
const homeSection = `${homeShell} py-12 sm:py-14 lg:py-16`;
const homeFirstSection = `${homeShell} pt-5 pb-12 sm:pt-10 sm:pb-14 lg:pt-10 lg:pb-16`;
const homeSectionHeader = "mb-6 flex items-baseline justify-between";
const homeCardGrid = "grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6";
// Featured work runs two wide cards side by side, using the wide thumbnails, then Design Studio's case study across the full width.
const homeWorkGrid = "grid grid-cols-1 gap-5 sm:grid-cols-2 lg:gap-6";
---

<PageLayout>

  {/* ── Hero ────────────────────────────────────────────── */}
  <section class={`${homeShell} pt-0 pb-4 sm:pb-10 md:pt-16 lg:pt-16 lg:pb-14`}>

    {/* Mobile layout */}
    <div class="hero-mobile md:hidden">
      <div class="hero-mobile-photo-field mb-8" data-hero-photo>
        <div class="hero-mobile-photo inline-block rotate-2 bg-white p-2 pb-5 shadow-xl shadow-black/15 transition-transform duration-300 hover:rotate-0 hover:scale-[1.02] dark:bg-[#20201e] dark:shadow-black/40">
          <div class="h-36 w-36 overflow-hidden">
            <img
              src="/images/brand/profile-living-room-avatar.jpg"
              alt="Patrick Morgan"
              class="block h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
      <PixelWaveText
        text={heroHeadline}
        as="h1"
        wave="hero"
        initialSans
        class="mb-7 max-w-[20rem] text-[2.05rem] font-medium leading-[1.08] tracking-tight"
      />
      <div class="mb-4 space-y-3 text-[15px] leading-relaxed" data-hero-desc>
        <p class="text-foreground/80">{heroIntro}</p>
        <p class="text-muted-foreground">{heroCurrentWorkLead} <a href="https://sublime.security" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4 hover:text-accent">Sublime</a>, writing my newsletter <a href={siteConfig.social.newsletter} target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4 hover:text-accent">Unknown Arts</a>, and building <a href="/design-studio" class="text-foreground underline underline-offset-4 hover:text-accent">Design Studio</a>, {heroCurrentWorkTail}</p>
      </div>
    </div>

    {/* Desktop: text left, photo right */}
    <div class="hero-desktop hidden md:flex md:items-center md:gap-10 lg:gap-14">

      {/* Left — all text */}
      <div class="flex-1 min-w-0">
        {/* Headline — PixelWave */}
        <PixelWaveText
          text={heroHeadline}
          as="h1"
          wave="headline"
          initialSans
          class="mb-8 text-4xl font-medium leading-[1.2] tracking-tight lg:text-[2.6rem] xl:text-5xl"
        />

        {/* Narrative */}
        <div class="max-w-xl space-y-4 text-base leading-relaxed xl:max-w-2xl" data-hero-desc>
          <p class="text-foreground/80">
            {heroIntro} {heroIntroDetail}
          </p>
          <p class="text-muted-foreground">
            {heroCurrentWorkLead} <a href="https://sublime.security" target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4 transition-colors hover:text-accent">Sublime</a>, writing my newsletter <a href={siteConfig.social.newsletter} target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4 transition-colors hover:text-accent">Unknown Arts</a>, and building <a href="/design-studio" class="text-foreground underline underline-offset-4 transition-colors hover:text-accent">Design Studio</a>, {heroCurrentWorkTail}
          </p>
        </div>

      </div>

      {/* Right — polaroid photo */}
      <div class="relative shrink-0 rotate-2 transition-transform duration-300 hover:rotate-0 hover:scale-[1.02]" data-hero-photo>
        {/* Polaroid frame */}
        <button
          type="button"
          class="group/builder block cursor-cell bg-white p-2 pb-8 text-left shadow-2xl shadow-black/20 outline-none transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-background dark:bg-[#20201e] dark:shadow-black/50 lg:p-3 lg:pb-10"
          data-builder-photo
          aria-pressed="false"
          aria-label="Run builder mode portrait animation"
        >
          <div class="relative h-52 w-52 overflow-hidden lg:h-64 lg:w-64 xl:h-72 xl:w-72">
            <img
              src="/images/brand/profile-living-room.jpg"
              alt="Patrick Morgan"
              class="block h-full w-full scale-[1.55] object-cover object-[43%_54%] transition duration-500 group-aria-pressed/builder:scale-[1.62] group-aria-pressed/builder:grayscale group-aria-pressed/builder:contrast-125 group-aria-pressed/builder:brightness-75 group-aria-pressed/builder:saturate-0 group-aria-pressed/builder:[image-rendering:pixelated]"
            />
            <div
              class="builder-grid pointer-events-none absolute inset-0 opacity-0 mix-blend-screen transition-opacity duration-500 group-aria-pressed/builder:opacity-80"
              aria-hidden="true"
            ></div>
            <div
              class="builder-scanlines pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-aria-pressed/builder:opacity-100"
              aria-hidden="true"
            ></div>
            <div
              class="pointer-events-none absolute inset-0 bg-cyan-900/0 transition-colors duration-500 group-aria-pressed/builder:bg-cyan-900/25"
              aria-hidden="true"
            ></div>
            <div
              class="builder-sweep pointer-events-none absolute inset-y-0 -left-1/2 w-1/2 opacity-0 transition-opacity duration-500 group-aria-pressed/builder:opacity-100"
              aria-hidden="true"
            ></div>
            <div
              class="builder-readout pointer-events-none absolute bottom-2 left-2 font-mono text-[10px] uppercase tracking-widest text-white/0 transition-colors duration-500 group-aria-pressed/builder:text-white/75"
              aria-hidden="true"
            >
              Developing...
            </div>
          </div>
        </button>
      </div>

    </div>

  </section>

  {/* ── Work ─────────────────────────────────────────────── */}
  <section class={homeFirstSection}>
    <div class={homeSectionHeader} data-home-section-header>
      <h2 class="text-lg font-semibold tracking-tight sm:text-xl">Work</h2>
      <a href="/work" class="text-sm text-muted-foreground transition-colors hover:text-foreground">View all →</a>
    </div>
    <div class={homeWorkGrid}>
      {professionalProjects.slice(0, 2).map((project, i) => (
        <div data-project-card-item>
          <ProjectCard
            title={project.data.title}
            description={featuredProjectDescriptions[project.id] ?? project.data.description}
            skills={project.data.skills}
            thumbnail={project.data.thumbnail}
            thumbnailDark={project.data.thumbnailDark}
            thumbnailWide={project.data.thumbnailWide}
            thumbnailWideDark={project.data.thumbnailWideDark}
            slug={project.id}
            index={i}
            variant="compact"
            showDescription
          >
            {liveDemoSlugs.has(project.id) && <ProjectDemo slot="visual" slug={project.id} />}
          </ProjectCard>
        </div>
      ))}
    </div>
    <div class="mt-5 lg:mt-6">
      <StudioHomeModule description={featuredProjectDescriptions["design-studio"]} />
    </div>
  </section>

  {/* ── Writing ──────────────────────────────────────────── */}
  <section class={homeSection}>
    <div class={homeSectionHeader} data-home-section-header>
      <h2 class="text-lg font-semibold tracking-tight sm:text-xl">Writing</h2>
      <a href="/writing" class="text-sm text-muted-foreground transition-colors hover:text-foreground">View all →</a>
    </div>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-6">

      {/* Left — newsletter card */}
      <div data-project-card-item>
        <a
          href={siteConfig.social.newsletter}
          target="_blank"
          rel="noopener noreferrer"
          class="group block h-full"
          aria-label="Unknown Arts newsletter"
        >
          <article class="h-full overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 group-hover:-translate-y-0.5 group-hover:shadow-md group-hover:shadow-black/5 dark:group-hover:shadow-black/20">
            <div class="newsletter-paper relative h-full min-h-[260px] w-full overflow-hidden bg-card">
              {/* The newsletter's own cover collage, cut out from its paper and laid on a matching paper for each theme. */}
              <img
                src="/images/unknown-arts/collage-cutout.webp"
                alt=""
                width="1232"
                height="928"
                class="newsletter-collage pointer-events-none absolute max-w-none transition-transform duration-300 group-hover:scale-[1.03]"
              />
              <div class="pointer-events-none absolute top-6 left-6 text-[#b38b6d] dark:text-[#f7ccab]">
                <UAMark color="currentColor" height={24} />
              </div>
              <div class="newsletter-text pointer-events-none absolute bottom-6 left-6 right-6">
                <p class="text-2xl font-medium leading-none tracking-tight text-foreground sm:text-[1.75rem] dark:text-[#ede9e3]">
                  Unknown Arts
                </p>
                <p class="mt-3 text-sm leading-relaxed text-pretty text-muted-foreground dark:text-[#ede9e3]/70">
                  Essays on how design, craft and building are changing with AI.
                </p>
                <p class="mt-2 font-mono text-xs text-muted-foreground/80 dark:text-[#ede9e3]/55">200+ published · 7,700+ readers</p>
              </div>
            </div>
          </article>
        </a>
      </div>

      {/* Right — article list */}
      <div data-project-card-item>
        <div class="flex flex-col divide-y divide-border">
          {writingPosts.slice(0, 6).map((post) => (
            <a
              href={`/writing/${post.id}`}
              class="group flex items-baseline justify-between gap-4 py-3 text-sm transition-colors hover:text-accent"
            >
              <span class="font-medium leading-snug">{shortTitle(post.data.title)}</span>
              <span class="shrink-0 font-mono text-xs text-muted-foreground">
                {post.data.publishedDate.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
              </span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  {/* ── Lab ──────────────────────────────────────────────── */}
  <section class={homeSection}>
    <div class={homeSectionHeader} data-home-section-header>
      <h2 class="text-lg font-semibold tracking-tight sm:text-xl">Lab</h2>
      <a href="/lab" class="text-sm text-muted-foreground transition-colors hover:text-foreground">View all →</a>
    </div>
    <div class={homeCardGrid}>
      {labEntries.slice(0, 3).map((entry) => (
        <div class="flex" data-project-card-item>
          <LabCard
            title={entry.data.title}
            description={entry.data.description}
            href={`/lab/${entry.data.slug}`}
            preview={entry.data.preview}
            headingLevel="h3"
          />
        </div>
      ))}
    </div>
  </section>

  {/* ── Community ────────────────────────────────────────── */}
  <section class={`${homeSection} pb-20 sm:pb-24 lg:pb-28`}>
    <div class={homeSectionHeader} data-home-section-header>
      <h2 class="text-lg font-semibold tracking-tight sm:text-xl">Community</h2>
      <a href="/community" class="text-sm text-muted-foreground transition-colors hover:text-foreground">View all →</a>
    </div>
    {/* Social proof, shown rather than told: one line, the photos, then what people say. The full story lives on /community. */}
    <p class="-mt-2 mb-8 max-w-2xl text-base text-pretty leading-relaxed text-muted-foreground" data-project-card-item>
      I host small gatherings for designers and builders in LA.
    </p>
    <div class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4 lg:gap-6" data-project-card-item>
      {homeCommunityPhotos.map((photo) => (
        <figure class:list={[
          "bg-white p-2 pb-7 shadow-xl shadow-black/15 transition-transform duration-300 hover:rotate-0 hover:scale-[1.02] dark:bg-[#20201e] dark:shadow-black/40",
          photo.className,
        ]}>
          <div class="aspect-[4/3] overflow-hidden bg-muted">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class:list={[
                "block h-full w-full object-cover",
                photo.position,
              ]}
            />
          </div>
        </figure>
      ))}
    </div>
    <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3">
      {communityCommendations.map((c) => c && (
        <blockquote class="mb-4 break-inside-avoid rounded-lg p-5 texture-bg" data-project-card-item>
          <p class="mb-4 font-mono text-[13px] leading-relaxed text-foreground">{c.quote}</p>
          <footer class="flex items-center gap-3">
            <img src={c.image} alt={c.name} class="h-8 w-8 shrink-0 rounded-full object-cover" loading="lazy" />
            <div>
              <p class="text-sm font-medium leading-tight">{c.name}</p>
              <p class="text-xs text-muted-foreground">{c.role}</p>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
  </section>

  {/* ── Closing ──────────────────────────────────────────── */}
  <section class={`${homeShell} pb-20 pt-2 text-center sm:pb-24 lg:pb-28`} data-cta-section>
    <PixelWaveText
      text="Let's craft a better future, together."
      as="p"
      wave="cta"
      initialSans
      class="text-3xl font-medium tracking-tight sm:text-4xl"
    />
  </section>

  <style>
    .hero-mobile {
      position: relative;
      isolation: isolate;
    }

    .hero-mobile::before {
      content: "";
      position: absolute;
      width: calc(100% + 3rem);
      height: 15.5rem;
      left: -1.5rem;
      top: -0.75rem;
      z-index: 0;
      background-image: radial-gradient(currentColor 1px, transparent 1.5px);
      background-size: 14px 14px;
      color: var(--foreground);
      opacity: 0.095;
      mask-image: linear-gradient(to bottom, black 0%, black 30%, transparent 88%);
    }

    .hero-mobile > * {
      position: relative;
      z-index: 1;
    }

    .hero-mobile-photo-field {
      position: relative;
      min-height: 12rem;
      padding-top: 2.25rem;
    }

    .hero-mobile-photo {
      position: relative;
      z-index: 1;
    }

    html.dark .hero-mobile::before {
      opacity: 0.1;
    }

    .hero-desktop {
      position: relative;
      isolation: isolate;
    }

    .hero-desktop > * {
      position: relative;
      z-index: 1;
    }

    .hero-desktop::before {
      content: "";
      display: none;
    }

    @media (min-width: 48rem) {
      .hero-desktop::before {
        position: absolute;
        display: block;
        width: min(34rem, 40vw);
        height: 26rem;
        left: 80%;
        top: 53%;
        z-index: 0;
        transform: translate(-50%, -50%) rotate(1deg);
        background-image: radial-gradient(currentColor 1px, transparent 1.5px);
        background-size: 14px 14px;
        color: var(--foreground);
        opacity: 0.105;
        mask-image: radial-gradient(ellipse at 55% 54%, black 0%, black 52%, transparent 82%);
      }
    }

    html.dark .hero-desktop::before {
      opacity: 0.11;
    }

    .builder-grid {
      background-image:
        linear-gradient(rgba(244, 238, 231, 0.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(244, 238, 231, 0.08) 1px, transparent 1px);
      background-size: 14px 14px;
    }

    .builder-scanlines {
      background-image: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.22) 0,
        rgba(0, 0, 0, 0.22) 1px,
        transparent 1px,
        transparent 4px
      );
      background-size: 100% 4px;
    }

    .builder-sweep {
      background: linear-gradient(
        90deg,
        transparent,
        rgba(244, 238, 231, 0.12),
        rgba(129, 230, 217, 0.18),
        transparent
      );
      mix-blend-mode: screen;
    }

    [data-builder-photo][aria-pressed="true"] .builder-grid {
      animation: builderGridDrift 3s linear both;
    }

    [data-builder-photo][aria-pressed="true"] .builder-scanlines {
      animation: builderScanDrift 1s linear 3;
    }

    [data-builder-photo][aria-pressed="true"] .builder-sweep {
      animation: builderSweep 3s ease-in-out both;
    }

    [data-builder-photo][aria-pressed="true"] .builder-readout {
      animation: builderPulse 1s ease-in-out 3;
    }

    @keyframes builderGridDrift {
      to {
        background-position: 56px 28px, 56px 28px;
      }
    }

    @keyframes builderScanDrift {
      to {
        background-position: 0 16px;
      }
    }

    @keyframes builderSweep {
      0%, 20% {
        transform: translateX(0);
      }
      70%, 100% {
        transform: translateX(320%);
      }
    }

    @keyframes builderPulse {
      0%, 100% {
        opacity: 0.72;
      }
      50% {
        opacity: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      [data-builder-photo][aria-pressed="true"] .builder-grid,
      [data-builder-photo][aria-pressed="true"] .builder-scanlines,
      [data-builder-photo][aria-pressed="true"] .builder-sweep,
      [data-builder-photo][aria-pressed="true"] .builder-readout {
        animation: none;
      }
    }

  /* Newsletter card, composed like an editorial page on the cover's own paper: the mark at the top left, the text at the bottom
     left, and the collage large on the right, bleeding off the card. Its left edge dissolves into the paper, so no band or
     gradient sits behind the text. On phones the collage moves up and the text takes the full width below it. */
  .newsletter-paper {
    background: var(--card) url("/images/unknown-arts/paper-light.webp") center / cover;
  }
  :global(.dark) .newsletter-paper {
    background-image: url("/images/unknown-arts/paper-dark.webp");
  }
  .newsletter-collage {
    top: -14%;
    right: -22%;
    height: 78%;
    width: auto;
    transform-origin: right top;
    mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
  }
  @media (min-width: 40rem) {
    /* Anchored just past the text column, so the collage never runs under the words at any card width; a wide card shows
       more of it and a narrow one crops its right side. */
    .newsletter-paper {
      container-type: inline-size;
    }
    .newsletter-collage {
      top: -17%;
      right: auto;
      left: 14rem;
      height: 134%;
      transform-origin: left center;
      mask-image: linear-gradient(90deg, transparent 4%, #000 26%);
    }
    .newsletter-text {
      right: auto;
      max-width: 16rem;
    }
    @container (max-width: 34rem) {
      .newsletter-collage {
        top: -8%;
        left: 14.5rem;
        height: 116%;
      }
      .newsletter-text {
        max-width: 14.5rem;
      }
    }
  }
  :global(.dark) .newsletter-collage {
    filter: brightness(0.92);
  }
  </style>

  <script>
    import "@/scripts/home-interactions";
    import "@/scripts/lab-previews";

    function initBuilderPhotos() {
      document.querySelectorAll<HTMLButtonElement>("[data-builder-photo]").forEach((button) => {
        if (button.dataset.initialized === "true") return;
        button.dataset.initialized = "true";

        button.addEventListener("click", () => {
          if (button.getAttribute("aria-pressed") === "true") return;

          button.setAttribute("aria-pressed", "true");
          window.setTimeout(() => {
            button.setAttribute("aria-pressed", "false");
          }, 3000);
        });
      });
    }

    initBuilderPhotos();
    document.addEventListener("astro:after-swap", initBuilderPhotos);
  </script>
</PageLayout>
