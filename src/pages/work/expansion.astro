---
import { getEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/icons/Icon.astro';
import { ArrowLeft01Icon } from '@hugeicons/core-free-icons';
import HeroBotSignals from '@/components/expansion/HeroBotSignals';
import RuleEditor from '@/components/expansion/RuleEditor';
import ThreePieces from '@/components/expansion/ThreePieces';
import AgentFlow from '@/components/expansion/AgentFlow';
import SignalChain from '@/components/expansion/SignalChain';
import Dashboards from '@/components/expansion/Dashboards';
import Kits from '@/components/expansion/Kits';
import '@/components/query-builder/query-builder.css';
import '@/components/query-builder/case-study.css';
import '@/components/expansion/expansion.css';

const project = await getEntry('projects', 'expansion');
if (!project) throw new Error('Expansion case study is missing');
---

<PageLayout title={project.data.title} description={project.data.description} image={project.data.thumbnailWide}>
  <article class="qb-page qb-case xp">
    <nav class="qb-case-nav" aria-label="Case study navigation">
      <a href="/work"><Icon icon={ArrowLeft01Icon} size={16} />Work</a>
    </nav>

    <header class="qb-slide qb-hero">
      <p class="qb-company"><img src="/images/logos/square-sigsci.svg" width="30" height="30" alt="" />Signal Sciences</p>
      <h1>Expanding a security platform for a new use case</h1>
      <p>I shaped how we brought a new SKU to market: better for customers and simpler to deliver.</p>
      <dl class="qb-brief">
        <div><dt>When</dt><dd>2019</dd></div>
        <div><dt>Role</dt><dd>Senior Product Designer</dd></div>
        <div><dt>Team</dt><dd>Product pod, about 3 months</dd></div>
        <div><dt>Outcome</dt><dd>A repeatable kit pattern</dd></div>
      </dl>
      <div class="qb-stage texture-bg xp-frame"><HeroBotSignals client:load /></div>
    </header>

    <section class="qb-slide" aria-labelledby="problem">
      <h2 id="problem">Customers were bending the firewall to fight bots</h2>
      <p>They wrote their own Signals to tag bot traffic, stretching the firewall beyond its original focus.</p>
      <div class="qb-stage texture-bg xp-frame"><RuleEditor client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="bet">
      <h2 id="bet">The expected answer was a separate bot product. I bet on the platform.</h2>
      <p>A dozen customer interviews showed we already had the pieces. Customers needed them connected.</p>
      <div class="qb-stage texture-bg xp-frame"><ThreePieces client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="mapping">
      <h2 id="mapping">I mapped where Signals and rules could act on a request</h2>
      <p>With our tech lead, I diagrammed the agent so the team could align before building the content.</p>
      <div class="qb-stage texture-bg xp-frame"><AgentFlow client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="response">
      <h2 id="response">I paired ready‑made detection with automatic response</h2>
      <p>Templated Signals tagged common bots, and rules blocked them without customers writing their own.</p>
      <div class="qb-stage texture-bg xp-frame"><SignalChain client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="monitoring">
      <h2 id="monitoring">I made it easy to see the defense working</h2>
      <p>Ready‑made dashboards tracked bot activity before and after rules took effect.</p>
      <div class="qb-stage texture-bg xp-frame"><Dashboards client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="outcome">
      <h2 id="outcome">Extending the platform beat rebuilding it</h2>
      <p>More kits were underway when the company was acquired and the work paused.</p>
      <div class="qb-stage texture-bg xp-frame"><Kits client:visible /></div>
    </section>

  </article>
</PageLayout>
