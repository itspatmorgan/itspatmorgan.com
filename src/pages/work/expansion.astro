---
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import Slide from '@/components/case-study/Slide.astro';
import { getCaseStudy } from '@/lib/case-study';
import HeroBotSignals from '@/components/expansion/HeroBotSignals';
import RuleEditor from '@/components/expansion/RuleEditor';
import ThreePieces from '@/components/expansion/ThreePieces';
import AgentFlow from '@/components/expansion/AgentFlow';
import SignalChain from '@/components/expansion/SignalChain';
import Dashboards from '@/components/expansion/Dashboards';
import Kits from '@/components/expansion/Kits';
import '@/components/case-study/case-study.css';
import '@/components/expansion/expansion.css';

const { project, slide } = await getCaseStudy('expansion');
---

<CaseStudyLayout project={project} product="xp">
  <HeroBotSignals slot="hero" client:load />

  <Slide {...slide('problem')}>
    <RuleEditor client:visible />
  </Slide>

  <Slide {...slide('bet')}>
    <ThreePieces client:visible />
  </Slide>

  <Slide {...slide('mapping')}>
    <AgentFlow client:visible />
  </Slide>

  <Slide {...slide('response')}>
    <SignalChain client:visible />
  </Slide>

  <Slide {...slide('monitoring')}>
    <Dashboards client:visible />
  </Slide>

  <Slide {...slide('outcome')}>
    <Kits client:visible />
  </Slide>
</CaseStudyLayout>
