---
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import Slide from '@/components/case-study/Slide.astro';
import { getCaseStudy } from '@/lib/case-study';
import HeroBotSignals from '@itspatmorgan/kit/expansion/HeroBotSignals';
import RuleEditor from '@itspatmorgan/kit/expansion/RuleEditor';
import ThreePieces from '@itspatmorgan/kit/expansion/ThreePieces';
import AgentFlow from '@itspatmorgan/kit/expansion/AgentFlow';
import SignalChain from '@itspatmorgan/kit/expansion/SignalChain';
import Dashboards from '@itspatmorgan/kit/expansion/Dashboards';
import Kits from '@itspatmorgan/kit/expansion/Kits';
import '@itspatmorgan/kit/case-study/case-study.css';
import '@itspatmorgan/kit/expansion/expansion.css';

const { project, slide } = await getCaseStudy('expansion');
---

<CaseStudyLayout project={project} product="xp">
  <HeroBotSignals slot="hero" client:load />

  <Slide {...slide('problem')}>
    <RuleEditor client:visible />
  </Slide>

  <Slide {...slide('bet')}>
    <ThreePieces client:visible />
  </Slide>

  <Slide {...slide('mapping')}>
    <AgentFlow client:visible />
  </Slide>

  <Slide {...slide('response')}>
    <SignalChain client:visible />
  </Slide>

  <Slide {...slide('monitoring')}>
    <Dashboards client:visible />
  </Slide>

  <Slide {...slide('outcome')}>
    <Kits client:visible />
  </Slide>
</CaseStudyLayout>
