---
import { getEntry } from 'astro:content';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import Slide from '@/components/case-study/Slide.astro';
import HeroBotSignals from '@/components/expansion/HeroBotSignals';
import RuleEditor from '@/components/expansion/RuleEditor';
import ThreePieces from '@/components/expansion/ThreePieces';
import AgentFlow from '@/components/expansion/AgentFlow';
import SignalChain from '@/components/expansion/SignalChain';
import Dashboards from '@/components/expansion/Dashboards';
import Kits from '@/components/expansion/Kits';
import '@/components/case-study/case-study.css';
import '@/components/expansion/expansion.css';

const project = await getEntry('projects', 'expansion');
if (!project) throw new Error('Expansion case study is missing');
---

<CaseStudyLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.thumbnailWide}
  product="xp"
  company={{ name: 'Signal Sciences', logo: '/images/logos/square-sigsci.svg' }}
  heading="Expanding a security platform for a new use case"
  subline="I shaped how we brought a new SKU to market: better for customers and simpler to deliver."
  brief={[
    ['When', '2019'],
    ['Role', 'Senior Product Designer'],
    ['Team', 'Product pod, about 3 months'],
    ['Outcome', 'A repeatable kit pattern'],
  ]}
>
  <div slot="hero" class="cs-stage texture-bg xp-frame"><HeroBotSignals client:load /></div>

  <Slide id="problem" title="Customers were bending the firewall to fight bots" line="They wrote their own Signals to tag bot traffic, stretching the firewall beyond its original focus.">
    <div class="cs-stage texture-bg xp-frame"><RuleEditor client:visible /></div>
  </Slide>

  <Slide id="bet" title="The expected answer was a separate bot product. I bet on the platform." line="A dozen customer interviews showed we already had the pieces. Customers needed them connected.">
    <div class="cs-stage texture-bg xp-frame"><ThreePieces client:visible /></div>
  </Slide>

  <Slide id="mapping" title="I mapped where Signals and rules could act on a request" line="With our tech lead, I diagrammed the agent so the team could align before building the content.">
    <div class="cs-stage texture-bg xp-frame"><AgentFlow client:visible /></div>
  </Slide>

  <Slide id="response" title="I paired ready‑made detection with automatic response" line="Templated Signals tagged common bots, and rules blocked them without customers writing their own.">
    <div class="cs-stage texture-bg xp-frame"><SignalChain client:visible /></div>
  </Slide>

  <Slide id="monitoring" title="I made it easy to see the defense working" line="Ready‑made dashboards tracked bot activity before and after rules took effect.">
    <div class="cs-stage texture-bg xp-frame"><Dashboards client:visible /></div>
  </Slide>

  <Slide id="outcome" title="Extending the platform beat rebuilding it" line="More kits were underway when the company was acquired and the work paused.">
    <div class="cs-stage texture-bg xp-frame"><Kits client:visible /></div>
  </Slide>
</CaseStudyLayout>
