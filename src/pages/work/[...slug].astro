---
import { getCollection } from "astro:content";
import { render } from "astro:content";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

export async function getStaticPaths() {
  // Query Builder and Expansion have dedicated pages at src/pages/work/query-language.astro and expansion.astro.
  const projects = await getCollection("projects", ({ id, data }) => !data.draft && id !== "query-language" && id !== "expansion");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, type, skills, thumbnail, heroImage } = project.data;
---

<ProjectLayout
  title={title}
  description={description}
  type={type}
  skills={skills}
  thumbnail={thumbnail}
  heroImage={heroImage}
>
  <Content />
</ProjectLayout>
