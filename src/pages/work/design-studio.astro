---
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import Slide from '@/components/case-study/Slide.astro';
import { getCaseStudy } from '@/lib/case-study';
import Workspace from '@itspatmorgan/kit/studio-case/Workspace';
import StudioRange from '@itspatmorgan/kit/design-studio/StudioRange';
import GalleryGrowth from '@itspatmorgan/kit/studio-case/GalleryGrowth';
import RulesMap from '@itspatmorgan/kit/studio-case/RulesMap';
import ScopeCheck from '@itspatmorgan/kit/studio-case/ScopeCheck';
import Handoff from '@itspatmorgan/kit/studio-case/Handoff';
import OpenStudio from '@itspatmorgan/kit/studio-case/OpenStudio';
import StudioQuote from '@/components/studio-case/StudioQuote.astro';
import StudioLesson from '@/components/studio-case/StudioLesson.astro';
import StudioPress from '@/components/studio-case/StudioPress.astro';
import '@itspatmorgan/kit/design-studio/studio-shapes.css';
import '@itspatmorgan/kit/case-study/case-study.css';
import '@itspatmorgan/kit/sublime/sublime.css';
import '@itspatmorgan/kit/studio-case/studio-case.css';

const { project, slide } = await getCaseStudy('design-studio');
---

<CaseStudyLayout project={project} product="sc">
  <nav slot="actions" class="sc-next sc-hero-links" aria-label="Design Studio">
    <a class="is-primary" href="/design-studio">Explore Design Studio</a>
    <a href="https://github.com/itspatmorgan/design-studio" target="_blank" rel="noopener noreferrer">Open source on GitHub</a>
  </nav>
  <Workspace slot="hero" client:load />

  <Slide {...slide('bet')}>
    <StudioRange client:visible />
  </Slide>

  <Slide {...slide('adoption')}>
    <GalleryGrowth client:visible />
  </Slide>

  <Slide {...slide('agents')}>
    <RulesMap client:visible />
  </Slide>

  <Slide {...slide('scope')}>
    <ScopeCheck client:visible />
  </Slide>

  <StudioQuote />

  <Slide {...slide('handoff')}>
    <Handoff client:visible />
  </Slide>

  <Slide {...slide('press')}>
    <StudioPress />
  </Slide>

  <Slide {...slide('rebuild')}>
    <OpenStudio client:visible />
  </Slide>

  <Slide {...slide('lesson')}>
    <StudioLesson />
  </Slide>
</CaseStudyLayout>
