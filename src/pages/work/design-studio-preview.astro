---
// Draft of the Design Studio case study, on a route nothing links to and search engines skip. It moves to /work/design-studio on
// Patrick's go-ahead (case-study-shaping, step 9).
import { getEntry } from 'astro:content';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import Slide from '@/components/case-study/Slide.astro';
import Workspace from '@/components/studio-case/Workspace';
import Spectrum from '@/components/studio-case/Spectrum';
import GalleryGrowth from '@/components/studio-case/GalleryGrowth';
import RulesMap from '@/components/studio-case/RulesMap';
import ScopeCheck from '@/components/studio-case/ScopeCheck';
import Handoff from '@/components/studio-case/Handoff';
import OpenStudio from '@/components/studio-case/OpenStudio';
import StudioQuote from '@/components/studio-case/StudioQuote.astro';
import StudioProof from '@/components/studio-case/StudioProof.astro';
import StudioLesson from '@/components/studio-case/StudioLesson.astro';
import '@/components/case-study/case-study.css';
import '@/components/studio-case/studio-case.css';

const project = await getEntry('projects', 'design-studio');
if (!project) throw new Error('Design Studio case study is missing');
---

<CaseStudyLayout
  title={project.data.title}
  description={project.data.description}
  product="sc"
  noindex
  company={{ name: 'Design Studio', logo: '/images/studio-case/design-studio-mark.svg' }}
  heading="Building a design environment for people and agents"
  subline="I designed and built Design Studio on my own. Sublime’s product team designs in it, and engineering builds from it."
  brief={[
    ['When', 'Jan 2026 to now'],
    ['Role', 'Creator, sole designer and builder'],
    ['Team', 'About 12 people at Sublime'],
    ['Outcome', 'Adopted by the whole product team, then open-sourced'],
  ]}
>
  <Workspace slot="hero" client:load />

  <Slide id="bet" title="AI prototypes were either throwaway or too heavy" line="Design Studio sits between: it knows the product, and stays apart from it to move fast.">
    <Spectrum client:visible />
  </Slide>

  <Slide id="adoption" title="The whole product team designs in one place" line="About a dozen people have made hundreds of prototypes, with several more each week.">
    <GalleryGrowth client:visible />
    <StudioQuote />
  </Slide>

  <Slide id="agents" title="Agents read the same rules the team does" line="One AGENTS.md file points every coding agent to the team’s rules, systems and skills.">
    <RulesMap client:visible />
  </Slide>

  <Slide id="scope" title="Each person works in a space no one else can break" line="Changes inside your own folder are approved on their own. Shared code gets a review.">
    <ScopeCheck client:visible />
  </Slide>

  <Slide id="handoff" title="Engineering builds from the prototype itself" line="Engineers wrote agent skills that turn a handed‑off prototype into production code.">
    <Handoff client:visible />
  </Slide>

  <Slide id="demand" title="People outside Sublime asked for their own" line="Viewers of a Dive Club interview asked for it. 600+ signed up for the launch lesson.">
    <StudioProof />
  </Slide>

  <Slide id="rebuild" title="Open source meant starting over, with what the team taught me" line="It had to stand apart from Sublime’s version. It builds on all I learned from the first.">
    <OpenStudio client:visible />
    <nav class="sc-next" aria-label="Design Studio">
      <a class="is-primary" href="/design-studio">Explore Design Studio</a>
      <a href="https://github.com/itspatmorgan/design-studio" target="_blank" rel="noopener noreferrer">View on GitHub</a>
    </nav>
  </Slide>

  <Slide id="lesson" title="Build the demo before the pitch" line="I never pitched Design Studio. I built it for myself, and people kept asking for it.">
    <StudioLesson />
  </Slide>
</CaseStudyLayout>
