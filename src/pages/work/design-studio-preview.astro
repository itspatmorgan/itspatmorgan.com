---
// Draft of the Design Studio case study, on a route nothing links to and search engines skip. It moves to /work/design-studio on
// Patrick's go-ahead (case-study-shaping, step 9).
import { getEntry } from 'astro:content';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import Slide from '@/components/case-study/Slide.astro';
import Workspace from '@/components/studio-case/Workspace';
import Spectrum from '@/components/studio-case/Spectrum';
import GalleryGrowth from '@/components/studio-case/GalleryGrowth';
import RulesMap from '@/components/studio-case/RulesMap';
import ScopeCheck from '@/components/studio-case/ScopeCheck';
import Handoff from '@/components/studio-case/Handoff';
import OpenStudio from '@/components/studio-case/OpenStudio';
import StudioQuote from '@/components/studio-case/StudioQuote.astro';
import StudioLesson from '@/components/studio-case/StudioLesson.astro';
import '@/components/case-study/case-study.css';
import '@/components/sublime/sublime.css';
import '@/components/studio-case/studio-case.css';

const project = await getEntry('projects', 'design-studio');
if (!project) throw new Error('Design Studio case study is missing');
---

<CaseStudyLayout
  title={project.data.title}
  description={project.data.description}
  product="sc"
  noindex
  company={{ name: 'Design Studio', logo: '/images/studio-case/design-studio-mark.svg' }}
  heading="Building a design environment for people and agents"
  subline="Design Studio is one codebase where a product team prototypes with AI agents, using the product’s real components. I designed and built it on my own at Sublime, then released an open-source version anyone can use."
  brief={[
    ['When', '2026 to now'],
    ['Role', 'Sole designer and builder'],
    ['Team', 'About 12 at Sublime'],
    ['Outcome', 'Adopted team-wide'],
  ]}
>
  <nav slot="actions" class="sc-next sc-hero-links" aria-label="Design Studio">
    <a class="is-primary" href="/design-studio">Explore Design Studio</a>
    <a href="https://github.com/itspatmorgan/design-studio" target="_blank" rel="noopener noreferrer">Open source on GitHub</a>
  </nav>
  <Workspace slot="hero" client:load />

  <Slide id="bet" title="AI prototypes were throwaway, and product code too heavy to explore in" line="Design Studio sits between them: the product’s real components and rules, in a repo of its own where trying ideas is cheap.">
    <Spectrum client:visible />
  </Slide>

  <Slide id="adoption" title="The whole product team designs in one place" line="About a dozen people have made hundreds of prototypes, with several more each week.">
    <GalleryGrowth client:visible />
  </Slide>

  <Slide id="agents" title="Agents follow the same rules the team does" line="People build by asking coding agents. One AGENTS.md file points every agent to the team’s rules, systems and skills.">
    <RulesMap client:visible />
  </Slide>

  <Slide id="scope" title="A dozen people share one codebase without breaking each other’s work" line="Each person owns a folder. Changes inside it are approved on their own; shared code gets a review.">
    <ScopeCheck client:visible />
  </Slide>

  <StudioQuote />

  <Slide id="handoff" title="Engineering builds from the prototype itself" line="An engineer points their agent at a prototype’s folder, and skills the engineers wrote turn it into production code.">
    <Handoff client:visible />
  </Slide>

  <Slide id="rebuild" title="Then I rebuilt it as open source, with what the team taught me" line="Sublime’s version is built around Sublime’s product, so the open-source one starts fresh for any team.">
    <OpenStudio client:visible />
    <nav class="sc-next" aria-label="Design Studio">
      <a class="is-primary" href="/design-studio">Explore Design Studio</a>
      <a href="https://github.com/itspatmorgan/design-studio" target="_blank" rel="noopener noreferrer">View on GitHub</a>
    </nav>
  </Slide>

  <Slide id="lesson" title="Build the demo before the pitch" line="I never pitched Design Studio. I built it for myself, and people kept asking for it.">
    <StudioLesson />
  </Slide>
</CaseStudyLayout>
