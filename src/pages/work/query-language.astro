---
import { getEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/icons/Icon.astro';
import { ArrowLeft01Icon } from '@hugeicons/core-free-icons';
import QueryBuilderDemo from '@/components/query-builder/QueryBuilderDemo';
import QuerySearchBlank from '@/components/query-builder/QuerySearchBlank';
import FigmaFlow from '@/components/query-builder/FigmaFlow';
import QuerySentence from '@/components/query-builder/QuerySentence';
import QueryNaturalLanguage from '@/components/query-builder/QueryNaturalLanguage';
import '@/components/query-builder/query-builder.css';
import '@/components/case-study/case-study.css';

const project = await getEntry('projects', 'query-language');
if (!project) throw new Error('Query Builder case study is missing');
---

<PageLayout title={project.data.title} description={project.data.description} image={project.data.thumbnailWide}>
  <article class="qb-page qb-case">
    <nav class="qb-case-nav" aria-label="Case study navigation">
      <a href="/work"><Icon icon={ArrowLeft01Icon} size={16} />Work</a>
    </nav>

    <header class="qb-slide qb-hero">
      <p class="qb-company"><img src="/images/logos/square-jupiterone.svg" width="30" height="30" alt="" />JupiterOne</p>
      <h1>Making a complex query language approachable</h1>
      <p>I designed a visual query builder that taught J1QL as customers used it.</p>
      <dl class="qb-brief">
        <div><dt>When</dt><dd>2022, pre-ChatGPT</dd></div>
        <div><dt>Role</dt><dd>Lead Product Designer</dd></div>
        <div><dt>Team</dt><dd>Designer + engineer, 3 months</dd></div>
        <div><dt>Outcome</dt><dd>First query in 1 day, not 21</dd></div>
      </dl>
      <div class="qb-stage texture-bg"><QueryBuilderDemo client:load /></div>
    </header>

    <section class="qb-slide" aria-labelledby="problem">
      <h2 id="problem">A blank box. No guidance.</h2>
      <p>Every question had to be written in J1QL, a proprietary graph query language. New customers didn’t know what to ask, or how.</p>
      <div class="qb-stage texture-bg"><QuerySearchBlank client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="insight">
      <h2 id="insight">I bet the language was worth teaching</h2>
      <p>The language was feature-rich but simple at its core. Getting the most out of the platform meant learning it.</p>
      <div class="qb-stage texture-bg"><QuerySentence client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="explore">
      <h2 id="explore">First, I showed people what they could ask</h2>
      <p>With our security team and customers, I organized hundreds of cyber asset types into categories anyone could browse.</p>
      <div class="qb-stage texture-bg"><FigmaFlow sequence="select" client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="filtering">
      <h2 id="filtering">Then, I showed them how to ask for it</h2>
      <p>They built the query visually, and every control mapped to a piece of the language.</p>
      <div class="qb-stage texture-bg"><FigmaFlow sequence="filter" client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="relationships">
      <h2 id="relationships">And I pushed toward full parity with the language</h2>
      <p>Even direction, written as &lt;&lt; or &gt;&gt; in a query, became a control people could see and switch.</p>
      <div class="qb-stage texture-bg"><FigmaFlow sequence="direction" client:visible /></div>
    </section>

    <section class="qb-slide" aria-labelledby="outcome">
      <h2 id="outcome">New customers were querying on day one</h2>
      <figure class="qb-days" aria-label="Average days from data integration to a first custom query: 21 before the builder, 1 after">
        <div class="qb-days-row"><span class="qb-days-label">Before</span><span class="qb-days-track" aria-hidden="true">{Array.from({ length: 21 }, () => <i />)}</span><span class="qb-days-value">21 days</span></div>
        <div class="qb-days-row qb-days-after"><span class="qb-days-label">After</span><span class="qb-days-track" aria-hidden="true">{Array.from({ length: 21 }, (_, day) => <i class={day ? 'qb-day-saved' : undefined} />)}</span><span class="qb-days-value">1 day</span></div>
      </figure>
      <blockquote class="qb-quote">
        <p>“The real gap between them and J1 is around ease of use… We really like the query builder for that exact reason.”</p>
        <footer>Genesis, shared by JupiterOne’s CRO</footer>
      </blockquote>
    </section>

    <section class="qb-slide" aria-labelledby="today">
      <h2 id="today">Today, I’d start with natural language</h2>
      <p>I’d let people ask in plain language, translate it into a query, and teach the language through that translation.</p>
      <div class="qb-stage texture-bg"><QueryNaturalLanguage client:visible /></div>
    </section>

  </article>
</PageLayout>
