---
import { getEntry } from 'astro:content';
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import Slide from '@/components/case-study/Slide.astro';
import QueryBuilderDemo from '@/components/query-builder/QueryBuilderDemo';
import QuerySearchBlank from '@/components/query-builder/QuerySearchBlank';
import FigmaFlow from '@/components/query-builder/FigmaFlow';
import QuerySentence from '@/components/query-builder/QuerySentence';
import QueryNaturalLanguage from '@/components/query-builder/QueryNaturalLanguage';
import '@/components/case-study/case-study.css';
import '@/components/query-builder/query-builder.css';

const project = await getEntry('projects', 'query-language');
if (!project) throw new Error('Query language case study is missing');
---

<CaseStudyLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.thumbnailWide}
  company={{ name: 'JupiterOne', logo: '/images/logos/square-jupiterone.svg' }}
  heading="Making a complex query language approachable"
  subline="I designed a visual query builder that taught J1QL as customers used it."
  brief={[
    ['When', '2022, pre-ChatGPT'],
    ['Role', 'Lead Product Designer'],
    ['Team', 'Designer + engineer, 3 months'],
    ['Outcome', 'First query in 1 day, not 21'],
  ]}
>
  <QueryBuilderDemo slot="hero" client:load />

  <Slide id="problem" title="A blank box. No guidance." line="Every question had to be written in J1QL, a proprietary graph query language. New customers didn’t know what to ask, or how.">
    <QuerySearchBlank client:visible />
  </Slide>

  <Slide id="insight" title="I bet the language was worth teaching" line="The language was feature-rich but simple at its core. Getting the most out of the platform meant learning it.">
    <QuerySentence client:visible />
  </Slide>

  <Slide id="explore" title="First, I showed people what they could ask" line="With our security team and customers, I organized hundreds of cyber asset types into categories anyone could browse.">
    <FigmaFlow sequence="select" client:visible />
  </Slide>

  <Slide id="filtering" title="Then, I showed them how to ask for it" line="They built the query visually, and every control mapped to a piece of the language.">
    <FigmaFlow sequence="filter" client:visible />
  </Slide>

  <Slide id="relationships" title="And I pushed toward full parity with the language" line="Even direction, written as << or >> in a query, became a control people could see and switch.">
    <FigmaFlow sequence="direction" client:visible />
  </Slide>

  <Slide id="outcome" title="New customers were querying on day one">
    <figure class="qb-days" aria-label="Average days from data integration to a first custom query: 21 before the builder, 1 after">
      <div class="qb-days-row"><span class="qb-days-label">Before</span><span class="qb-days-track" aria-hidden="true">{Array.from({ length: 21 }, () => <i />)}</span><span class="qb-days-value">21 days</span></div>
      <div class="qb-days-row qb-days-after"><span class="qb-days-label">After</span><span class="qb-days-track" aria-hidden="true">{Array.from({ length: 21 }, (_, day) => <i class={day ? 'qb-day-saved' : undefined} />)}</span><span class="qb-days-value">1 day</span></div>
    </figure>
    <blockquote class="qb-quote">
      <p>“The real gap between them and J1 is around ease of use… We really like the query builder for that exact reason.”</p>
      <footer>Genesis, shared by JupiterOne’s CRO</footer>
    </blockquote>
  </Slide>

  <Slide id="today" title="Today, I’d start with natural language" line="I’d let people ask in plain language, translate it into a query, and teach the language through that translation.">
    <QueryNaturalLanguage client:visible />
  </Slide>
</CaseStudyLayout>
