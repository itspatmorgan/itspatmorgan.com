---
import ExploreShell from "@/components/design-studio/explore/ExploreShell.astro";
import DialsHero from "@/components/design-studio/explore/DialsHero";
import Icon from "@/components/icons/Icon.astro";
import { Copy01Icon, ArrowUpRight01Icon } from "@hugeicons/core-free-icons";
import { installationPrompt } from "@/data/design-studio-setup";
---

<ExploreShell variant="dials" title="Dials">
  <header class="dx-hero">
    <h1>Design with intent.<br class="dx-br" /> Build with an agent.</h1>
    <p class="dx-line">An open-source prototype sandbox for designers and PMs.</p>
    <div class="dx-actions">
      <button type="button" class="dx-primary" data-copy-text={installationPrompt}><Icon icon={Copy01Icon} size={16} /><span data-copy-face>Copy setup prompt</span></button>
      <a class="dx-text-link" href="/design-studio-demo/">Try the live demo <Icon icon={ArrowUpRight01Icon} size={14} /></a>
    </div>
    <div class="dx-stage"><DialsHero client:load /></div>
  </header>
</ExploreShell>
