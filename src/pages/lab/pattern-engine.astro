---
// The Pattern Engine moved to pm-studio. Articles' older links, and the laboratory article, still point here, often
// with an article's settings in the address, so this page passes them on. public/_redirects handles the rest of /lab.
import { patternEngineUrl } from "@/data/featured";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Pattern Engine — Patrick Morgan</title>
    <link rel="canonical" href={patternEngineUrl} />
    <meta http-equiv="refresh" content={`0; url=${patternEngineUrl}`} />
    <script is:inline define:vars={{ patternEngineUrl }}>
      location.replace(patternEngineUrl + location.search);
    </script>
  </head>
  <body>
    <p>The Pattern Engine now lives in my studio: <a href={patternEngineUrl}>open it there</a>.</p>
  </body>
</html>
