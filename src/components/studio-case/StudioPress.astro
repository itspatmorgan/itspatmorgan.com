---
// Where Design Studio was seen outside Sublime, at Patrick's ask (2026-10-30): the Dive Club interview (aired August 2026), the Maven
// Lightning Lesson with Xinran Ma that launched the open-source version (October 2026: 600+ registered, 100+ live), and the launch
// post on X. Shown as the media itself, like the two video cards on the work page: the same YouTube and Maven covers
// (src/data/experience.ts), and for the launch post the first frame of the demo video it carried (Drive open-source-demo.mp4).
// A cover that can't load falls back to the source's name on a quiet fill, never a broken image.
// Patrick's count for the launch posts on X and LinkedIn together: 30k+ views (2026-10-30).
import { HugeiconsIcon } from '@hugeicons/react';
import { ArrowUpRight01Icon, PlayIcon } from '@hugeicons/core-free-icons';

const items = [
  {
    image: 'https://i.ytimg.com/vi/628c4YuxAEM/maxresdefault.jpg', alt: 'Dive Club episode cover: building an agent-agnostic prototyping platform',
    fallback: 'Dive Club', title: 'Dive Club interview', sub: 'Podcast · Aug 2026',
    href: 'https://www.youtube.com/watch?v=628c4YuxAEM',
  },
  {
    image: 'https://d2426xcxuh3ht5.cloudfront.net/f9OPHTgQSIKMI3CQ7KfX_Duo%20Instructor%20-%20theme%20a.jpg', alt: 'Maven lesson cover: Build your own AI design sandbox, with Patrick Morgan and Xinran Ma',
    fallback: 'Maven', title: 'Maven Lightning Lesson', sub: 'With Xinran Ma · 600+ registered',
    href: 'https://maven.com/p/0e87f2/build-your-own-ai-design-sandbox',
  },
  {
    image: '/images/studio-case/launch-post.jpg', alt: 'The launch video: a coding agent beside the open-source Design Studio, with the Feedback Inbox handoff canvas open',
    fallback: 'X', title: 'Open-source launch post', sub: '30k+ views on X and LinkedIn',
    href: 'https://x.com/itspatmorgan/status/2114742504738443277',
  },
];
---

<ul class="sc-press">
  {items.map(item => (
    <li>
      <a href={item.href} target="_blank" rel="noopener noreferrer">
        <span class="sc-press-media">
          <span class="sc-press-fallback" aria-hidden="true">{item.fallback}</span>
          <img src={item.image} alt={item.alt} loading="lazy" onerror="this.remove()" />
          <span class="sc-press-play" aria-hidden="true"><HugeiconsIcon icon={PlayIcon} size={18} strokeWidth={1.8} /></span>
        </span>
        <span class="sc-press-text">
          <span class="sc-press-title">{item.title}<HugeiconsIcon icon={ArrowUpRight01Icon} size={16} strokeWidth={1.8} /></span>
          <span class="sc-press-sub">{item.sub}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .sc-press { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; max-width: 1040px; margin: 48px auto 0; padding: 0; list-style: none; text-align: left; }
  .sc-press a { display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid var(--border); border-radius: 16px; background: var(--card); color: var(--foreground); text-decoration: none; transition: transform .3s, box-shadow .3s; }
  .sc-press a:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgb(0 0 0 / .06); }
  .sc-press-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--muted); border-bottom: 1px solid var(--border); }
  .sc-press-fallback { position: absolute; inset: 0; display: grid; place-items: center; font-size: 22px; font-weight: 500; letter-spacing: -.02em; color: var(--muted-foreground); }
  .sc-press-media img { position: relative; display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .sc-press a:hover .sc-press-media img { transform: scale(1.02); }
  .sc-press-play { position: absolute; left: 12px; bottom: 12px; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; background: rgb(255 255 255 / .92); color: #111; box-shadow: 0 1px 4px rgb(0 0 0 / .18); }
  .sc-press-text { display: flex; flex-direction: column; gap: 2px; padding: 14px 18px 16px; }
  .sc-press-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 16px; line-height: 22px; font-weight: 500; letter-spacing: -.01em; }
  .sc-press-title :global(svg) { flex: none; color: var(--muted-foreground); transition: color .2s; }
  .sc-press a:hover .sc-press-title :global(svg) { color: var(--foreground); }
  .sc-press-sub { font-size: 14px; line-height: 20px; color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
  @media (max-width: 860px) {
    .sc-press { grid-template-columns: minmax(0, 1fr); max-width: 560px; margin-top: 28px; gap: 12px; }
  }
</style>
