---
// Where Design Studio was seen outside Sublime, at Patrick's ask (2026-10-30): the Dive Club interview (aired August 2026), the Maven
// Lightning Lesson with Xinran Ma that launched the open-source version (October 2026: 600+ registered, 100+ live), and the launch
// post on X, whose opening lines are quoted as posted. The view count is Patrick's figure for the launch posts on X and LinkedIn.
// Drawn as type rather than thumbnails: no cover art for these is in the repo or Drive, and stand-in art would not be the real thing.
import { HugeiconsIcon } from '@hugeicons/react';
import { ArrowUpRight01Icon, Mic01Icon, Mortarboard01Icon, NewTwitterIcon } from '@hugeicons/core-free-icons';

const items = [
  {
    icon: Mic01Icon, kind: 'Podcast', when: 'Aug 2026', title: 'Dive Club',
    body: 'A conversation about Design Studio. Designers outside Sublime asked for their own, which led to the open-source version.',
    href: 'https://www.youtube.com/watch?v=628c4YuxAEM', cta: 'Watch the interview',
  },
  {
    icon: Mortarboard01Icon, kind: 'Lightning Lesson', when: 'Oct 2026', title: 'Maven, with Xinran Ma',
    stat: ['600+', 'registered, and more than 100 joined live'],
    body: 'The open-source launch: how to build your own AI design sandbox.',
    href: 'https://maven.com/p/0e87f2/build-your-own-ai-design-sandbox', cta: 'See the lesson',
  },
  {
    icon: NewTwitterIcon, kind: 'Launch post', when: 'Oct 2026', title: '“I built my team an AI design sandbox. Now I’m open-sourcing a better version for everyone.”',
    stat: ['10k–20k', 'views on X and LinkedIn'],
    href: 'https://x.com/itspatmorgan/status/2114742504738443277', cta: 'Read on X', quote: true,
  },
];
---

<ul class="sc-press">
  {items.map(item => (
    <li class={item.quote ? 'is-quote' : ''}>
      <p class="sc-press-kind"><HugeiconsIcon icon={item.icon} size={16} strokeWidth={1.7} />{item.kind}<span>{item.when}</span></p>
      <h3>{item.title}</h3>
      {item.stat && <p class="sc-press-stat"><b>{item.stat[0]}</b>{item.stat[1]}</p>}
      {item.body && <p class="sc-press-body">{item.body}</p>}
      <a href={item.href} target="_blank" rel="noopener noreferrer">{item.cta}<HugeiconsIcon icon={ArrowUpRight01Icon} size={15} strokeWidth={1.8} /></a>
    </li>
  ))}
</ul>

<style>
  .sc-press { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; max-width: 1040px; margin: 48px auto 0; padding: 0; list-style: none; text-align: left; }
  .sc-press li { display: flex; flex-direction: column; padding: 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); }
  .sc-press-kind { display: flex; align-items: center; gap: 7px; margin: 0; font-size: 14px; color: var(--muted-foreground); }
  .sc-press-kind span { margin-left: auto; font-variant-numeric: tabular-nums; }
  .sc-press h3 { margin-top: 28px; font-size: 22px; line-height: 1.2; font-weight: 500; letter-spacing: -.025em; text-wrap: balance; }
  .sc-press .is-quote h3 { font-size: 19px; line-height: 1.3; letter-spacing: -.015em; }
  .sc-press-stat { display: flex; flex-direction: column; gap: 2px; margin-top: 20px; font-size: 14px; line-height: 20px; color: var(--muted-foreground); }
  .sc-press-stat b { font-size: 32px; line-height: 1.1; font-weight: 500; letter-spacing: -.03em; color: var(--foreground); font-variant-numeric: tabular-nums; }
  .sc-press-body { margin-top: 12px; font-size: 15px; line-height: 22px; color: var(--muted-foreground); text-wrap: pretty; }
  .sc-press a { display: inline-flex; align-items: center; gap: 4px; margin-top: auto; padding-top: 24px; font-size: 14px; font-weight: 500; color: var(--foreground); text-decoration: none; }
  .sc-press a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 860px) {
    .sc-press { grid-template-columns: minmax(0, 1fr); max-width: 560px; margin-top: 28px; gap: 12px; }
    .sc-press li { padding: 20px; }
    .sc-press h3 { margin-top: 20px; }
  }
</style>
