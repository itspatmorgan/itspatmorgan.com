---
// Outside demand for Design Studio: the Dive Club interview that started it, the Maven lesson with Xinran Ma that launched it, and
// the launch posts. Real links with their real covers, set as quiet cards rather than an infographic. Figures are Patrick's
// (2026-10-30): 600+ registered and 100+ live for Maven; 10,000 to 20,000 views across the launch posts.
const talks = [
  {
    kind: 'Podcast · Aug 2026',
    title: 'Dive Club: an AI-assisted prototyping environment',
    note: 'The walkthrough that made people ask for their own.',
    href: 'https://www.youtube.com/watch?v=628c4YuxAEM',
    image: 'https://i.ytimg.com/vi/628c4YuxAEM/maxresdefault.jpg',
    alt: 'Dive Club episode cover',
  },
  {
    kind: 'Maven lesson · Oct 2026',
    title: 'Build your own AI design sandbox, with Xinran Ma',
    note: 'The launch: 600+ signed up, 100+ watched live.',
    href: 'https://maven.com/p/0e87f2/build-your-own-ai-design-sandbox',
    image: 'https://d2426xcxuh3ht5.cloudfront.net/f9OPHTgQSIKMI3CQ7KfX_Duo%20Instructor%20-%20theme%20a.jpg',
    alt: 'Maven lesson cover',
  },
];
const posts = [
  { kind: 'LinkedIn', title: 'I built my team an AI design sandbox. Now I’m open-sourcing a better version for everyone.', href: 'https://www.linkedin.com/feed/update/urn:li:activity:7520509267661983745/' },
  { kind: 'X', title: 'The launch video: Codex driving a whole Design Studio workflow.', href: 'https://x.com/itspatmorgan/status/2114742504738443277' },
];
---

<div class="sc-proof">
  <div class="sc-talks">
    {talks.map(t => (
      <a class="sc-talk" href={t.href} target="_blank" rel="noopener noreferrer">
        <img src={t.image} alt={t.alt} loading="lazy" decoding="async" width="1280" height="720" />
        <small>{t.kind}</small>
        <b>{t.title}</b>
        <span>{t.note}</span>
      </a>
    ))}
  </div>
  <div class="sc-links">
    {posts.map(p => (
      <a class="sc-link" href={p.href} target="_blank" rel="noopener noreferrer">
        <small>{p.kind} · launch post</small>
        <b>{p.title}</b>
      </a>
    ))}
    <div class="sc-link sc-stat"><small>Reach</small><b>10,000 to 20,000 views</b><span>across the launch posts</span></div>
  </div>
</div>
