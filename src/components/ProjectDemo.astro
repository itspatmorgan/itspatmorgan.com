---
// A case study's project card visual, in place of a thumbnail. Each is a card-sized composition of its case study's real product
// components (see ProjectCardStage): Sublime's recommended rule, Query Builder's query as code and as controls, and Signal Sciences' Bot
// Signals card, and Design Studio's artifact types. It sits in an inert frame, so the card stays one link and nothing in the visual takes focus.
import SublimeCard from "@itspatmorgan/kit/sublime/SublimeCard";
import QueryCard from "@itspatmorgan/kit/query-builder/QueryCard";
import ExpansionCard from "@itspatmorgan/kit/expansion/ExpansionCard";
import StudioCard from "@itspatmorgan/kit/design-studio/StudioCard";
import "@itspatmorgan/kit/case-study/case-study.css";
import "@itspatmorgan/kit/case-study/project-card.css";
import "@itspatmorgan/kit/query-builder/query-builder.css";
import "@itspatmorgan/kit/expansion/expansion.css";
import "@itspatmorgan/kit/sublime/sublime.css";
import "@itspatmorgan/kit/design-studio/studio-card.css";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="project-demo" inert aria-hidden="true">
  {slug === "sublime-agents" && <SublimeCard client:visible />}
  {slug === "query-language" && <QueryCard client:visible />}
  {slug === "expansion" && <ExpansionCard client:visible />}
  {slug === "design-studio" && <StudioCard size="card" client:visible />}
</div>

<style>
  /* The card sets the 16:9 frame and its texture; the visual, drawn at the same proportions, fills it. */
  .project-demo { position: absolute; inset: 0; overflow: hidden; }
</style>
