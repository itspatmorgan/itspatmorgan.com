---
// Matches the page template above it: the showcase shell (1024px of content) or the 720px reading column.
const { template = "reading" } = Astro.props as { template?: "showcase" | "reading" };
---

<footer class="py-8 sm:py-10">
  <div class:list={["mx-auto flex w-full items-center justify-between", template === "showcase" ? "max-w-[1136px] px-6 sm:px-8 lg:px-14" : "max-w-3xl px-6"]}>
    <a
      href="/colophon"
      class="text-xs text-muted-foreground/70 transition-colors hover:text-foreground"
    >
      Colophon
    </a>
    <div class="flex items-center gap-3 whitespace-nowrap text-xs text-muted-foreground/60">
      <span>&copy; {new Date().getFullYear()}</span>
      {/* Sidebar already shows local time on desktop. */}
      <span class="md:hidden">
        <span class="font-mono text-xs text-muted-foreground tabular-nums whitespace-nowrap">
          LA&nbsp;&middot;&nbsp;<span data-footer-local-time>--:--</span>
        </span>
      </span>
    </div>
  </div>
</footer>

<script>
  function initFooterLocalTime() {
    document.querySelectorAll<HTMLElement>("[data-footer-local-time]").forEach((time) => {
      if (time.dataset.initialized === "true") return;
      time.dataset.initialized = "true";

      function updateTime() {
        time.textContent = new Date().toLocaleTimeString("en-US", {
          timeZone: "America/Los_Angeles",
          hour: "numeric",
          minute: "2-digit",
          hour12: true,
        });
      }

      updateTime();

      const now = new Date();
      const msUntilNextMinute = (60 - now.getSeconds()) * 1000 - now.getMilliseconds();
      window.setTimeout(() => {
        updateTime();
        window.setInterval(updateTime, 60_000);
      }, msUntilNextMinute);
    });
  }

  initFooterLocalTime();
  document.addEventListener("astro:after-swap", initFooterLocalTime);
</script>
