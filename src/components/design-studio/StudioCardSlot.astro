---
// Renders a StudioCard concept in an inert frame, as ProjectDemo does for the Work cards.
import { StudioCardCanvas, StudioCardContext, StudioCardScaffold, StudioCardShapes } from "@/components/design-studio/StudioCard";
import "@/components/case-study/case-study.css";

export type StudioConcept = "shapes" | "scaffold" | "context" | "canvas";
interface Props { concept: StudioConcept; }
const { concept } = Astro.props;
---

<div inert aria-hidden="true">
  {concept === "shapes" && <StudioCardShapes client:visible />}
  {concept === "scaffold" && <StudioCardScaffold client:visible />}
  {concept === "context" && <StudioCardContext client:visible />}
  {concept === "canvas" && <StudioCardCanvas client:visible />}
</div>
