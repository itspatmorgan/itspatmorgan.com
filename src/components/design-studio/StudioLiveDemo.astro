---
import StudioTabBar from '@/components/design-studio/StudioTabBar.astro';
import Icon from '@/components/icons/Icon.astro';
import { ArrowLeft01Icon, ArrowRight01Icon } from '@hugeicons/core-free-icons';
const demo = 'https://itspatmorgan.com/design-studio-demo/';
---

<div data-live-studio class="live-demo">
  <div class="demo-heading mb-7 max-w-2xl">
    <h2 class="text-3xl font-medium leading-tight tracking-tight sm:text-4xl">Explore a published Design Studio.</h2>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground">Create and edit locally, then publish for your team. Explore the shared experience below.</p>
  </div>
  <div class="browser-frame overflow-hidden rounded-xl border border-border bg-background shadow-xl shadow-black/5 dark:shadow-black/20">
    <div class="flex items-center gap-4 bg-muted/50 px-3 py-1.5 sm:px-4">
      <div aria-hidden="true" class="flex shrink-0 gap-1.5"><span class="browser-dot"></span><span class="browser-dot"></span><span class="browser-dot"></span></div>
      <StudioTabBar label="Published Design Studio" kind="demo" inline variant="browser">
        <button id="live-studio-tab" type="button" role="tab" aria-selected="true" aria-controls="live-demo-panel">Design Studio</button>
      </StudioTabBar>
    </div>
    <div class="browser-toolbar flex items-center gap-2 border-y border-border bg-muted/50 px-3 py-2 sm:gap-3 sm:px-4">
      <div aria-hidden="true" class="browser-controls flex shrink-0 gap-1.5">
        <span class="browser-control"><Icon icon={ArrowLeft01Icon} size={14} /></span>
        <span class="browser-control"><Icon icon={ArrowRight01Icon} size={14} /></span>
      </div>
      <a data-demo-open href={demo} target="_blank" rel="noopener noreferrer" aria-label="Open current Studio page in a new tab" class="browser-address flex min-w-0 flex-1 items-center justify-between gap-3 rounded-md border border-border/60 bg-background/80 px-3 py-1.5 text-xs text-muted-foreground hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring"><span data-demo-address class="truncate">itspatmorgan.com/design-studio-demo/</span><span aria-hidden="true">↗</span></a>
      <div aria-hidden="true" class="browser-controls flex shrink-0 gap-1.5">
        <span class="browser-control"><span class="browser-panel-icon"></span></span>
        <span class="browser-control"><span class="browser-menu-icon"><i></i><i></i><i></i></span></span>
      </div>
    </div>
    <div id="live-demo-panel" role="tabpanel" aria-labelledby="live-studio-tab" tabindex="0" class="relative" aria-busy="true" data-demo-panel>
      <div class="demo-viewport overflow-x-auto"><iframe data-demo-studio title="Explore the published Design Studio" class="demo-frame block border-0" style="visibility: hidden"></iframe></div>
      <div data-demo-status role="status" data-loading="true" class="demo-loading absolute inset-0 z-10 bg-background">
        <div aria-hidden="true" class="demo-skeleton">
          <div class="skeleton-rail"><span></span><span></span><span></span><span></span></div>
          <div class="skeleton-content"><div class="skeleton-heading"></div><div class="skeleton-line"></div><div class="skeleton-sheet"><span></span><span></span><span></span><span></span></div></div>
        </div>
        <span data-demo-status-label class="sr-only">Loading Design Studio…</span>
      </div>
    </div>
  </div>
  <noscript><p class="demo-noscript p-5">Enable JavaScript to explore here, or <a href={demo} class="underline">open the published project</a>.</p></noscript>
</div>

<style>
  .live-demo { container-type: inline-size; }
  .demo-heading { display: none; }
  .browser-frame { display: none; }
  .demo-noscript { display: none; }
  @container (min-width: 760px) {
    .demo-heading { display: block; padding-top: 3.5rem; }
    .browser-frame { margin-bottom: 3.5rem; }
    .demo-noscript { display: block; }
    .live-demo[data-demo-enhanced] .browser-frame { display: block; }
  }
  [hidden] { display: none !important; }
  .browser-dot { width: 9px; height: 9px; border: 1px solid var(--border); border-radius: 50%; background: var(--muted); }
  .browser-controls { pointer-events: none; color: var(--muted-foreground); opacity: .45; }
  .browser-control { display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border: 1px solid var(--border); border-radius: 5px; }
  .browser-panel-icon { width: 12px; height: 11px; border: 1px solid currentColor; border-radius: 2px; background: linear-gradient(to right, transparent 3px, currentColor 3px, currentColor 4px, transparent 4px); }
  .browser-menu-icon { display: flex; gap: 2px; }
  .browser-menu-icon i { width: 2px; height: 2px; border-radius: 50%; background: currentColor; }
  .demo-viewport :global(.demo-frame) { width: 100%; min-width: 760px; height: 600px; background: var(--background); }
  .demo-viewport :global([hidden]) { display: none !important; }
  .demo-viewport { min-height: 600px; }
  .demo-skeleton { display: flex; height: 100%; opacity: .65; }
  .skeleton-rail { width: 48px; flex-shrink: 0; padding: 20px 12px; border-right: 1px solid var(--border); }
  .skeleton-rail span { display: block; height: 20px; margin-bottom: 22px; border-radius: 5px; background: var(--muted); }
  .skeleton-content { flex: 1; padding: 48px 36px; }
  .skeleton-heading { width: 35%; max-width: 230px; height: 20px; border-radius: 4px; background: var(--muted); }
  .skeleton-line { width: 60%; height: 10px; margin-top: 16px; border-radius: 4px; background: var(--muted); }
  .skeleton-sheet { margin-top: 36px; padding: 24px; border: 1px solid var(--border); border-radius: 6px; }
  .skeleton-sheet span { display: block; width: 85%; height: 10px; margin: 12px 0 28px; border-radius: 4px; background: var(--muted); }
  .skeleton-sheet span:nth-child(even) { width: 65%; }
  .demo-loading[data-loading="true"] .skeleton-content { animation: loading-breathe 1.6s ease-in-out infinite alternate; }
  .demo-loading[data-loading="false"] { display: flex; align-items: center; justify-content: center; padding: 32px; text-align: center; font-size: .875rem; color: var(--muted-foreground); }
  .demo-loading[data-loading="false"] .demo-skeleton { display: none; }
  .demo-loading[data-loading="false"] [data-demo-status-label] { position: static; width: auto; height: auto; clip-path: none; white-space: normal; }
  @keyframes loading-breathe { to { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) { .demo-loading[data-loading="true"] .skeleton-content { animation: none; } }
</style>

<script>
  import { initStudioLiveDemo } from '@/scripts/studio-live-demo';
  document.querySelectorAll<HTMLElement>('[data-live-studio]').forEach(root => {
    // Load the actual Studio only when this section has enough room to use it.
    // Once loaded, retain it across resizing so visitors keep their place.
    const observer = new ResizeObserver(entries => {
      if (entries.some(entry => entry.contentRect.width >= 760)) {
        observer.disconnect();
        root.dataset.demoEnhanced = 'true';
        initStudioLiveDemo(root);
      }
    });
    observer.observe(root);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  });
</script>
