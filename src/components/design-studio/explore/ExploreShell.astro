---
// The frame shared by the hero explorations: a lean Design Studio header, the hero (the page's own slot), Joe's quote, and the
// setup paths that left the hero. A switcher at the bottom moves between the three. Not linked from the site, and noindex.
import PageLayout from "@/layouts/PageLayout.astro";
import Icon from "@/components/icons/Icon.astro";
import { GithubIcon, ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { agentHarnesses } from "@/data/design-studio-setup";
import "@/components/studio-case/studio-case.css";
import "@/components/case-study/case-study.css";

interface Props { variant: "dials" | "prompt" | "product"; title: string }
const { variant, title } = Astro.props;
const views = [
  { key: "dials", label: "Dials", href: "/design-studio-explore/dials" },
  { key: "prompt", label: "Prompt", href: "/design-studio-explore/prompt" },
  { key: "product", label: "Product", href: "/design-studio-explore/product" },
];
---

<PageLayout template="showcase" title={`Design Studio hero: ${title}`} description="An exploration of the Design Studio landing page hero." noindex>
  <div class={`dx-page dx-${variant}-page`}>
    <div class="mx-auto w-full max-w-[1136px] px-6 sm:px-8 lg:px-14">
      <header class="dx-header">
        <a href="/design-studio" class="dx-brand" aria-label="Design Studio">
          <svg width="22" height="21" viewBox="12.48 12 25.03 24" fill="currentColor" aria-hidden="true"><path d="M21.3943 12H12.48V36H21.3943V12Z" /><path d="M23.7944 12H25.5087C28.6913 12 31.7436 13.2643 33.994 15.5147C36.2444 17.7652 37.5087 20.8174 37.5087 24C37.5087 27.1826 36.2444 30.2348 33.994 32.4853C31.7436 34.7357 28.6913 36 25.5087 36H23.7944V12Z" /></svg>
          <span>Design Studio</span>
          <span class="dx-beta">Beta</span>
        </a>
        <nav class="dx-header-links" aria-label="Design Studio">
          <a href="#get-started" class="dx-hide-phone">Get started</a>
          <a href="/design-studio/agent.txt" class="dx-hide-phone">For agents</a>
          <a href="https://github.com/itspatmorgan/design-studio" aria-label="Design Studio on GitHub"><Icon icon={GithubIcon} size={18} /></a>
        </nav>
      </header>

      <slot />

      <section class="dx-after">
        <figure class="dx-quote">
          <blockquote>“We have essentially replaced Figma with this at Sublime.”</blockquote>
          <figcaption>Joe Salowitz, Product Designer at Sublime</figcaption>
        </figure>
      </section>

      <section id="get-started" class="dx-after dx-setup">
        <h2>Set up in one paste</h2>
        <p>Copy the setup prompt and paste it into your coding agent. It installs Design Studio and opens the preview.</p>
        <div class="dx-setup-row">
          {agentHarnesses.map((h) => <span><span class="dx-logo" style={`--logo: url(${h.logo})`} aria-hidden="true"></span>{h.title}</span>)}
        </div>
        <p class="dx-setup-agent">Or point your agent at <a href="/design-studio/agent.txt">itspatmorgan.com/design-studio/agent.txt</a></p>
        <a class="dx-continue" href="/design-studio">The rest of the page continues as it is today <Icon icon={ArrowRight01Icon} size={14} /></a>
      </section>
    </div>

    <nav class="dx-switch" aria-label="Hero explorations">
      {views.map((v) => <a href={v.href} aria-current={v.key === variant ? "page" : undefined}>{v.label}</a>)}
    </nav>
  </div>
</PageLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((button) => {
    const face = button.querySelector("[data-copy-face]");
    const label = face?.textContent ?? "";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyText ?? "");
        if (face) face.textContent = "Copied";
        window.setTimeout(() => { if (face) face.textContent = label; }, 2200);
      } catch { document.getElementById("get-started")?.scrollIntoView({ behavior: "smooth" }); }
    });
  });
</script>

<style is:global>
  .dx-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 28px; }
  .dx-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; letter-spacing: -.01em; white-space: nowrap; }
  .dx-beta { padding: 1px 7px; border-radius: 999px; border: 1px solid var(--border); font: 11px/16px 'Geist Mono Variable', ui-monospace, monospace; color: var(--muted-foreground); }
  .dx-header-links { display: flex; align-items: center; gap: 24px; font-size: 14px; color: var(--muted-foreground); }
  .dx-header-links a { display: inline-flex; align-items: center; min-height: 44px; transition: color 160ms; }
  .dx-header-links a:hover { color: var(--foreground); }

  .dx-hero { padding-top: clamp(56px, 9vw, 112px); text-align: center; }
  .dx-hero > h1 { margin: 0 auto; max-width: none; font-size: clamp(38px, 6vw, 72px); line-height: 1; font-weight: 500; letter-spacing: -.04em; text-wrap: balance; }
  .dx-hero > .dx-line { max-width: 30em; margin: 20px auto 0; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.5; color: var(--muted-foreground); text-wrap: balance; }
  .dx-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 24px; margin-top: 32px; }
  .dx-primary { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 999px; background: var(--foreground); color: var(--background); font-size: 15px; font-weight: 500; }
  .dx-text-link { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 500; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, currentColor 30%, transparent); }
  .dx-stage { margin-top: clamp(40px, 6vw, 72px); }

  .dx-product-page .dx-hero { text-align: left; }
  .dx-product-page .dx-hero > h1 { margin: 0; font-size: clamp(40px, 6.2vw, 80px); }
  .dx-product-page .dx-hero > .dx-line { margin-left: 0; }
  .dx-product-page .dx-actions { justify-content: flex-start; }

  .dx-after { padding-top: clamp(80px, 12vw, 144px); text-align: center; }
  .dx-quote blockquote { max-width: 22ch; margin: 0 auto; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.15; font-weight: 500; letter-spacing: -.03em; text-wrap: balance; }
  .dx-quote figcaption { margin-top: 20px; color: var(--muted-foreground); }
  .dx-setup h2 { font-size: clamp(28px, 3.4vw, 40px); font-weight: 500; letter-spacing: -.03em; }
  .dx-setup > p { max-width: 32em; margin: 16px auto 0; color: var(--muted-foreground); text-wrap: balance; }
  .dx-setup-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 20px; margin-top: 24px; font-size: 14px; }
  .dx-setup-row > span { display: inline-flex; align-items: center; gap: 6px; }
  .dx-setup .dx-setup-agent { font-size: 14px; }
  .dx-setup-agent a { text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .dx-continue { display: inline-flex; align-items: center; gap: 6px; margin: 56px 0 120px; font-size: 14px; color: var(--muted-foreground); }

  .dx-switch { position: fixed; left: 50%; bottom: 20px; z-index: 40; display: flex; gap: 2px; padding: 4px; transform: translateX(-50%); border-radius: 999px; background: color-mix(in oklch, var(--background) 80%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 0 0 1px var(--border), 0 8px 24px -8px rgb(0 0 0 / .2); }
  .dx-switch a { padding: 6px 14px; border-radius: 999px; font-size: 13px; color: var(--muted-foreground); }
  .dx-switch a[aria-current] { background: var(--foreground); color: var(--background); }

  @media (max-width: 640px) {
    .dx-beta, .dx-header-links .dx-hide-phone { display: none; }
    .dx-header { padding-top: 16px; }
    .dx-hero { padding-top: 40px; }
    .dx-hero > h1 { font-size: clamp(34px, 9.6vw, 44px); }
    .dx-actions { margin-top: 24px; }
    .dx-product-page .dx-hero > h1 { font-size: clamp(34px, 9.6vw, 44px); }
  }
</style>
