---
// Design Studio's case study card, the wide one beneath the homepage's two Work cards: the case study's title and description beside a
// live visual on the project card system (StudioCard). Like a Work card, the whole card opens the case study and hovering it replays the
// visual. Its type matches the Work cards'.
import { getEntry } from "astro:content";
import StudioCard from "@/components/design-studio/StudioCard";
import "@/components/case-study/case-study.css";

interface Props {
  description: string;
}

const { description } = Astro.props;
const project = await getEntry("projects", "design-studio");
if (!project) throw new Error("Design Studio case study is missing");
const caseStudy = "/work/design-studio";
---

    <div data-project-card-item class="group relative" data-project-card>
      <a href={caseStudy} class="absolute inset-0 z-10 rounded-xl" aria-label={project.data.title}></a>
      <article class="grid overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 group-hover:-translate-y-0.5 group-hover:shadow-md group-hover:shadow-black/5 dark:group-hover:shadow-black/20 motion-reduce:translate-y-0 motion-reduce:transition-none lg:grid-cols-[1fr_2fr]">
        {/* The case study's title and description at the bottom of the column, at the Work cards' sizes, the way the newsletter
            card sets its text, so the open space above reads as intended. */}
        <div class="order-2 flex flex-col justify-end p-4 lg:order-1 lg:p-6">
          <h3 class="mb-2 text-base font-semibold tracking-tight">{project.data.title}</h3>
          <p class="max-w-md text-sm leading-relaxed text-muted-foreground">{description}</p>
        </div>
        {/* The visual, 16:9 like the Work cards' and in the same inert frame. */}
        <div class="texture-bg relative order-1 flex items-center overflow-hidden border-b border-border lg:order-2 lg:border-b-0 lg:border-l">
          <div class="w-full" inert aria-hidden="true"><StudioCard client:visible /></div>
        </div>
      </article>
    </div>
