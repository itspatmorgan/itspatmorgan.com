---
// The homepage's Open source card for Design Studio: title, description and talks beside a live visual on the project card system
// (StudioCard). Like a Work card, hovering the card replays the visual.
import Icon from "@/components/icons/Icon.astro";
import StudioCard from "@/components/design-studio/StudioCard";
import "@/components/case-study/case-study.css";
import { PlayCircleIcon } from "@hugeicons/core-free-icons";

const designStudioLinks = [
  { label: "Dive Club interview", href: "https://www.youtube.com/watch?v=628c4YuxAEM", icon: PlayCircleIcon },
  { label: "Maven talk", href: "https://maven.com/p/0e87f2/build-your-own-ai-design-sandbox", icon: PlayCircleIcon },
];
---

    <div data-project-card-item>
      <article data-project-card class="group grid overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/5 dark:hover:shadow-black/20 motion-reduce:translate-y-0 motion-reduce:transition-none lg:grid-cols-[1fr_2fr]">
        {/* Two parts: the main content (title, description and the landing page link) centered in the column, and the two talks pinned
            to the bottom beneath a divider inset to the content's width, stacked. The repo link sits in the section header. */}
        <div class="order-2 flex flex-col lg:order-1">
          <div class="flex flex-1 flex-col justify-center p-5 sm:p-6 lg:p-8">
            <h2 id="home-design-studio-title" class="flex items-center gap-3 text-xl font-semibold tracking-tight sm:text-2xl xl:text-3xl">
              <svg viewBox="0 0 40 32" fill="currentColor" class="h-5 w-[25px] shrink-0 sm:h-6 sm:w-[30px] xl:h-[30px] xl:w-[37.5px]" aria-hidden="true"><path d="M0 0h11v32H0zM15 0h3a16 16 0 0 1 0 32h-3z" /></svg>
              <span>Design Studio</span>
            </h2>
            <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted-foreground sm:text-base lg:text-sm xl:text-base">An AI prototype sandbox for designers and product managers who build.</p>
            <a href="/design-studio" aria-label="Explore Design Studio" class="mt-5 inline-flex w-fit items-center gap-2 text-sm font-medium transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring xl:text-base">Explore <span aria-hidden="true">→</span></a>
          </div>
          <div class="px-5 pb-5 sm:px-6 sm:pb-6 lg:px-8 lg:pb-8">
          <ul class="grid gap-2 border-t border-border/70 pt-4 text-[13px] text-muted-foreground lg:pt-5" aria-label="More about Design Studio">
            {designStudioLinks.map((link) => (
              <li><a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition-colors hover:text-foreground"><Icon icon={link.icon} size={15} aria-hidden="true" />{link.label}</a></li>
            ))}
          </ul>
          </div>
        </div>
        {/* The visual, 16:9 like the Work cards' and in the same inert frame. The whole column links to the landing page. */}
        <div class="texture-bg relative order-1 flex items-center overflow-hidden border-b border-border lg:order-2 lg:border-b-0 lg:border-l">
          <a href="/design-studio" class="absolute inset-0 z-10" aria-label="Explore Design Studio" tabindex="-1"></a>
          <div class="w-full" inert aria-hidden="true"><StudioCard client:visible /></div>
        </div>
      </article>
    </div>
