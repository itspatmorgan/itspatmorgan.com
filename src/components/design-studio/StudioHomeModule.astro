---
// The homepage's Open source card for Design Studio: title, description and links beside a live visual on the project card system
// (StudioCard). Like a Work card, it opens the case study, and hovering the card replays the visual.
import StudioCard from "@/components/design-studio/StudioCard";
import "@/components/case-study/case-study.css";

const caseStudy = "/work/design-studio";
---

    <div data-project-card-item>
      <article data-project-card class="group grid overflow-hidden rounded-xl border border-border bg-card transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/5 dark:hover:shadow-black/20 motion-reduce:translate-y-0 motion-reduce:transition-none lg:grid-cols-[1fr_2fr]">
        {/* The content, centered in its column: title, description, the case study link and a quieter one to the landing page. The talks
            live in the case study's media section, and the repo link sits in the section header. */}
        <div class="order-2 flex flex-col justify-center p-5 sm:p-6 lg:order-1 lg:p-8">
          <h2 id="home-design-studio-title" class="flex items-center gap-3 text-xl font-semibold tracking-tight sm:text-2xl xl:text-3xl">
            <svg viewBox="0 0 40 32" fill="currentColor" class="h-5 w-[25px] shrink-0 sm:h-6 sm:w-[30px] xl:h-[30px] xl:w-[37.5px]" aria-hidden="true"><path d="M0 0h11v32H0zM15 0h3a16 16 0 0 1 0 32h-3z" /></svg>
            <span>Design Studio</span>
          </h2>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted-foreground sm:text-base lg:text-sm xl:text-base">An AI prototype sandbox for designers and product managers who build. I built it for Sublime’s product team, then rebuilt it as open source.</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm xl:text-base">
            <a href={caseStudy} class="inline-flex items-center gap-2 font-medium transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">Read the case study <span aria-hidden="true">→</span></a>
            <a href="/design-studio" class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring">Try it <span aria-hidden="true">→</span></a>
          </div>
        </div>
        {/* The visual, 16:9 like the Work cards' and in the same inert frame. The whole column opens the case study. */}
        <div class="texture-bg relative order-1 flex items-center overflow-hidden border-b border-border lg:order-2 lg:border-b-0 lg:border-l">
          <a href={caseStudy} class="absolute inset-0 z-10" aria-label="Read the Design Studio case study" tabindex="-1"></a>
          <div class="w-full" inert aria-hidden="true"><StudioCard client:visible /></div>
        </div>
      </article>
    </div>
