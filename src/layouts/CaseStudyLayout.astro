---
import PageLayout from './PageLayout.astro';
import Icon from '@/components/icons/Icon.astro';
import { ArrowLeft01Icon, Share01Icon } from '@hugeicons/core-free-icons';

// A case study: "← Work", then the hero (company, title, subline, brief, a note for phones, and the hero visual in the `hero` slot), then
// one Slide per point in the default slot. The product's stylesheet and its namespace class (`product`) come from the page.
interface Props {
  title: string;
  description: string;
  image?: string;
  product?: string;
  company: { name: string; logo: string };
  heading: string;
  subline: string;
  brief: [label: string, value: string][];
}

const { title, description, image, product, company, heading, subline, brief } = Astro.props;
---

<PageLayout title={title} description={description} image={image}>
  <article class:list={['cs-page', product]}>
    <nav class="cs-nav" aria-label="Case study navigation">
      <a href="/work"><Icon icon={ArrowLeft01Icon} size={16} />Work</a>
    </nav>

    <header class="cs-slide cs-hero">
      <p class="cs-company"><img src={company.logo} width="30" height="30" alt="" />{company.name}</p>
      <h1>{heading}</h1>
      <p>{subline}</p>
      <dl class="cs-brief">
        {brief.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
      {/* Phones only: the demos are desktop products, cropped to one part of the screen. Share hands the link on, to open somewhere larger. */}
      <aside class="cs-phone-note">
        <p>These are desktop products. On a phone, each demo shows one part of the screen. Open this page on a larger screen for the full walk-through.</p>
        <button type="button" class="cs-share" data-title={title}><Icon icon={Share01Icon} size={15} /><span>Share</span></button>
      </aside>
      <slot name="hero" />
    </header>

    <slot />
  </article>
</PageLayout>

<script>
  // The phone's share sheet where there is one; otherwise copy the link.
  document.querySelectorAll<HTMLButtonElement>('.cs-share').forEach(button => {
    const label = button.querySelector('span')!;
    button.addEventListener('click', async () => {
      const url = location.href.split('#')[0];
      if (navigator.share) {
        try { await navigator.share({ title: button.dataset.title, url }); } catch { /* dismissed */ }
        return;
      }
      try { await navigator.clipboard.writeText(url); label.textContent = 'Link copied'; } catch { label.textContent = 'Copy failed'; }
      window.setTimeout(() => { label.textContent = 'Share'; }, 2000);
    });
  });
</script>
