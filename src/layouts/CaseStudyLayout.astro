---
import PageLayout from './PageLayout.astro';
import Icon from '@/components/icons/Icon.astro';
import { ArrowLeft01Icon } from '@hugeicons/core-free-icons';

// A case study: "← Work", then the hero (company, title, subline, brief, and the hero visual in the `hero` slot), then one Slide per
// point in the default slot. The product's stylesheet and its namespace class (`product`) come from the page.
interface Props {
  title: string;
  description: string;
  image?: string;
  product?: string;
  company: { name: string; logo: string };
  heading: string;
  subline: string;
  brief: [label: string, value: string][];
}

const { title, description, image, product, company, heading, subline, brief } = Astro.props;
---

<PageLayout title={title} description={description} image={image}>
  <article class:list={['cs-page', product]}>
    <nav class="cs-nav" aria-label="Case study navigation">
      <a href="/work"><Icon icon={ArrowLeft01Icon} size={16} />Work</a>
    </nav>

    <header class="cs-slide cs-hero">
      <p class="cs-company"><img src={company.logo} width="30" height="30" alt="" />{company.name}</p>
      <h1>{heading}</h1>
      <p>{subline}</p>
      <dl class="cs-brief">
        {brief.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
      <slot name="hero" />
    </header>

    <slot />
  </article>
</PageLayout>
