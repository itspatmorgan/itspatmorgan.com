---
import "../styles/global.css";
import { siteConfig } from "@/data/site-config";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  /** Open Graph type: "article" for writing, "website" for everything else. */
  type?: "website" | "article";
}

const { title, description, image, canonicalUrl, noindex = false, type = "website" } = Astro.props;

const pageTitle = title ?? siteConfig.title;
const pageDescription = description ?? siteConfig.description;
const canonicalURL = canonicalUrl ?? new URL(Astro.url.pathname, siteConfig.url).toString();
// Share images are 1200x630. Pages without their own use the homepage card.
const ogImage = new URL(image ?? "/images/share/home.jpg", siteConfig.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/GeistPixel-Square.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    {/* Native document transitions preserve normal script and browser lifecycles.
        All site pages share the same restrained crossfade. */}
    <style is:inline>
      @supports selector(:active-view-transition-type(page-navigation)) {
        @view-transition {
          navigation: auto;
          types: page-navigation;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        @view-transition { navigation: none; }
      }
    </style>

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={siteConfig.xHandle} />
    <meta name="twitter:creator" content={siteConfig.xHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    {/* Cloudflare Web Analytics: cookieless, so no consent banner. It loads only on the live domain, so previews and
        local builds stay out of the numbers. */}
    {siteConfig.analyticsToken && (
      <script is:inline define:vars={{ token: siteConfig.analyticsToken, host: new URL(siteConfig.url).hostname }}>
        if (location.hostname === host) {
          const beacon = document.createElement("script");
          beacon.defer = true;
          beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
          beacon.dataset.cfBeacon = JSON.stringify({ token });
          document.head.append(beacon);
        }
      </script>
    )}

    {/* Prevent flash of wrong theme */}
    <script is:inline>
      (() => {
      // Storage can be unavailable (an embedded preview); a read that throws must not stop the theme from following the system.
      const stored = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
      // Light or dark: a page shown inside a viewer that sets data-theme on the root (the artifact preview) follows the viewer, at load
      // and whenever it switches. Otherwise a saved choice wins, then the system setting, which is followed live until a choice is saved.
      const root = document.documentElement;
      const system = window.matchMedia("(prefers-color-scheme: dark)");
      const host = () => { const t = root.getAttribute("data-theme"); return t === "dark" || t === "light" ? t : null; };
      const applyTheme = (dark) => { root.classList.toggle("dark", dark); root.style.colorScheme = dark ? "dark" : "light"; };
      const theme = stored("theme");
      applyTheme(host() ? host() === "dark" : theme ? theme === "dark" : system.matches);
      new MutationObserver(() => { if (host()) applyTheme(host() === "dark"); })
        .observe(root, { attributes: true, attributeFilter: ["data-theme"] });
      system.addEventListener("change", (event) => { if (!host() && !stored("theme")) applyTheme(event.matches); });

      // The home hero opens in pixel type and dissolves to sans on the first visit of a session. Start it in pixel type before the
      // first paint, so the sans headline never flashes and then jumps. home-interactions.ts removes the class as the dissolve begins.
      const session = (key) => { try { return sessionStorage.getItem(key); } catch { return null; } };
      if (location.pathname === "/" && !session("pixelWaveSeen") && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        root.classList.add("pw-intro");
        setTimeout(() => root.classList.remove("pw-intro"), 3000);
      }

      const sidebarPreference = stored("sidebar-collapsed");
      if (sidebarPreference === null || sidebarPreference === "true") {
        document.documentElement.classList.add("sidebar-collapsed");
      }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
