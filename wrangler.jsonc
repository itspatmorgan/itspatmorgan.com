// Cloudflare Workers static hosting. CI builds dist/ (Astro plus the Design
// Studio demo) and uploads it; there is no Worker script, only assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itspatmorgan",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve the root 404.html for missing routes, as GitHub Pages does.
    // Its inline script loads Studio for direct demo URLs.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true
}
