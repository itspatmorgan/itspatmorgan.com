# Astro's build output is content-hashed, so browsers can keep it for a year
# and skip revalidating CSS and scripts on every page navigation.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts in public/fonts keep stable names, so cache them for a day
# and let browsers reuse them while they check for a newer copy.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
